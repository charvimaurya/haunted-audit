# Copy this file to .env. Never commit .env or real keys.
# The local demo (scripted mode) works with the AWS lines left blank.
# Fill them in only if you run the LLM agent on Amazon Bedrock.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Claude via Bedrock. Temperature stays low so repeated journeys are comparable.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_TEMPERATURE=0.1
BEDROCK_MAX_TOKENS=1024

# Public list rates used only to turn real token counts into a dollar figure.
# Scripted mode records 0 tokens, so its cost is 0.
BEDROCK_INPUT_USD_PER_MTOK=3.0
BEDROCK_OUTPUT_USD_PER_MTOK=15.0

# SQLite file for the FastAPI run store.
HAUNTED_AUDIT_DB=data/runs.db

# Public staging API (see .kiro/specs/staging-deployment). Safe defaults shown.
# Exact origins only, comma separated. Unset = local dev origins.
CORS_ALLOWED_ORIGINS=
# LLM mode is paused on the public demo unless this is "true".
LLM_ENABLED=false
LLM_DAILY_RUN_CAP=20
RATE_PER_MINUTE=5
RATE_PER_HOUR=30
MAX_CONCURRENT_RUNS=2
