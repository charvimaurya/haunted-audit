{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Haunted Audit API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "agent.api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-q"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: agent/tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "agent/tests",
        "-q"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Scripted journey: broken",
      "type": "debugpy",
      "request": "launch",
      "module": "agent.keyboard_agent.runner",
      "args": [
        "--variant",
        "broken",
        "--mode",
        "scripted"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Scripted journey: fixed",
      "type": "debugpy",
      "request": "launch",
      "module": "agent.keyboard_agent.runner",
      "args": [
        "--variant",
        "fixed",
        "--mode",
        "scripted"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
